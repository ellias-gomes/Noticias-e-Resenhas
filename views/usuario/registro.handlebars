{{#each erros}}
    <div class="alert alert-danger container mt-2">{{texto}}</div>
{{/each}}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-5">
            <div class="card border-0 shadow-sm p-4" style="border-top: 5px solid #FFB800 !important;">
                <div class="text-center mb-3">
                    <span class="badge-category mb-2">COMUNIDADE</span>
                    <h1 class="h3 fw-bold">Criar Nova Conta</h1>
                </div>
                <form action="/users/registro" method="post">
                    <div class="mb-3">
                        <label for="nome" class="form-label fw-semibold">Nome de exibição:</label>
                        <input type="text" name="nome" id="nome" placeholder="Como seu nome aparecerá nos comentários" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">E-mail:</label>
                        <input type="email" name="email" id="email" placeholder="seu@email.com" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="senha" class="form-label fw-semibold">Senha (mín. 5 caracteres):</label>
                        <input type="password" name="senha" id="senha" placeholder="Crie uma senha" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="senha2" class="form-label fw-semibold">Confirmar Senha:</label>
                        <input type="password" name="senha2" id="senha2" placeholder="Repita a senha" class="form-control" required>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" name="novidades" id="inputNovidades" class="form-check-input" checked required>
                        <label for="inputNovidades" class="form-check-label small text-muted">
                            Concordo com os termos da comunidade para comentar e interagir.
                        </label>
                    </div>
                    <button type="submit" class="btn btn-yellow w-100 py-2">Criar Minha Conta</button>
                </form>
                <hr class="my-4">
                <div class="text-center small">
                    Já possui cadastro? <a href="/users/login" class="fw-bold text-dark">Entrar agora</a>
                </div>
            </div>
        </div>
    </div>
</div>
