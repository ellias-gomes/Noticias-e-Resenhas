<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge-category mb-1">GERENCIAMENTO DO PORTAL</span>
            <h1 class="display-6 fw-bold mb-0">Painel Administrativo</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/postagens/add" class="btn btn-yellow">+ Nova Matéria</a>
            <a href="/admin/categorias/add" class="btn btn-dark">+ Nova Categoria</a>
        </div>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">📰</div>
                <div class="h3 fw-bolder mb-0">{{stats.postagens}}</div>
                <div class="small text-muted fw-semibold">Publicações</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">👁</div>
                <div class="h3 fw-bolder mb-0">{{stats.views}}</div>
                <div class="small text-muted fw-semibold">Visualizações</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">★</div>
                <div class="h3 fw-bolder mb-0">{{stats.likes}}</div>
                <div class="small text-muted fw-semibold">Curtidas</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">💬</div>
                <div class="h3 fw-bolder mb-0">{{stats.comentarios}}</div>
                <div class="small text-muted fw-semibold">Comentários</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">🏷</div>
                <div class="h3 fw-bolder mb-0">{{stats.categorias}}</div>
                <div class="small text-muted fw-semibold">Editorias</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card h-100">
                <div class="stat-icon mb-2">👥</div>
                <div class="h3 fw-bolder mb-0">{{stats.usuarios}}</div>
                <div class="small text-muted fw-semibold">Usuários</div>
            </div>
        </div>
    </div>

    <!-- Atalhos de Módulos -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4" style="border-left: 5px solid #FFB800 !important;">
                <h5 class="fw-bold">Gerenciar Postagens</h5>
                <p class="text-muted small mb-3">Crie, edite, exclua matérias e selecione quais notícias aparecem no carrossel da capa.</p>
                <a href="/admin/postagens" class="btn btn-dark btn-sm mt-auto">Acessar Postagens →</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4" style="border-left: 5px solid #FFB800 !important;">
                <h5 class="fw-bold">Gerenciar Editorias</h5>
                <p class="text-muted small mb-3">Organize as seções e categorias temáticas do portal de notícias.</p>
                <a href="/admin/categorias" class="btn btn-dark btn-sm mt-auto">Acessar Categorias →</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4" style="border-left: 5px solid #FFB800 !important;">
                <h5 class="fw-bold">Gerenciar Usuários</h5>
                <p class="text-muted small mb-3">Visualize leitores cadastrados, promova novos administradores ou remova contas.</p>
                <a href="/users" class="btn btn-dark btn-sm mt-auto">Acessar Usuários →</a>
            </div>
        </div>
    </div>

    <!-- Tabela de Publicações Recentes -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Matérias Recentes & Desempenho</h5>
            <a href="/admin/postagens" class="btn btn-outline-dark btn-sm">Ver todas</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Editoria</th>
                        <th>Carousel</th>
                        <th>Views</th>
                        <th>Curtidas</th>
                        <th>Data</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each recentPosts}}
                        <tr>
                            <td class="fw-semibold">{{titulo}}</td>
                            <td>
                                {{#if categoria.nome}}
                                    <span class="badge-category">{{categoria.nome}}</span>
                                {{else}}
                                    <span class="badge bg-secondary">Sem categoria</span>
                                {{/if}}
                            </td>
                            <td>
                                {{#if carousel}}
                                    <span class="badge bg-success">Destaque</span>
                                {{else}}
                                    <span class="badge bg-light text-dark border">Padrão</span>
                                {{/if}}
                            </td>
                            <td>{{views}}</td>
                            <td>{{likes}}</td>
                            <td class="small text-muted">{{formatDate date}}</td>
                            <td class="text-end">
                                <a href="/post/{{slug}}" class="btn btn-outline-dark btn-sm">Ver</a>
                                <a href="/admin/postagens/edit/{{_id}}" class="btn btn-yellow btn-sm">Editar</a>
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Nenhuma postagem cadastrada.</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>
