{{#each erros}}
    <div class="alert alert-danger container mt-2">
        {{texto}}
    </div>
{{/each}}
<div class="container mt-4 mb-5">
    <div class="card border-0 shadow-sm p-4" style="border-top: 5px solid #FFB800 !important;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge-category mb-1">REDAÇÃO</span>
                <h1 class="h3 fw-bold mb-0">Nova Publicação</h1>
            </div>
            <a href="/admin/postagens" class="btn btn-outline-dark btn-sm">← Voltar</a>
        </div>
        <hr>

        <form action="/admin/postagens/nova" method="post" enctype="multipart/form-data">
            <div class="row g-3">
                <div class="col-12 col-md-7">
                    <label for="titulo" class="form-label fw-bold">Título da Matéria:</label>
                    <input type="text" name="titulo" id="titulo" placeholder="Digite o título principal da notícia" class="form-control" required>
                </div>
                <div class="col-12 col-md-5">
                    <label for="slug" class="form-label fw-bold">Slug (URL amigável):</label>
                    <input type="text" name="slug" id="slug" placeholder="ex: titulo-da-noticia" class="form-control" required>
                </div>

                <div class="col-12">
                    <label for="descricao" class="form-label fw-bold">Subtítulo / Resumo:</label>
                    <input type="text" name="descricao" id="descricao" placeholder="Breve resumo exibido na capa e nos cards" class="form-control" required>
                </div>

                <div class="col-12">
                    <label for="conteudo" class="form-label fw-bold">Conteúdo Completo da Notícia:</label>
                    <textarea name="conteudo" id="conteudo" cols="30" rows="10" placeholder="Escreva o corpo da reportagem..." class="form-control"></textarea>
                </div>

                <div class="col-12 col-md-3">
                    <label for="autor" class="form-label fw-bold">Autor / Repórter:</label>
                    <input type="text" name="autor" id="autor" value="{{#if user}}{{user.nome}}{{else}}Redação{{/if}}" class="form-control" required>
                </div>

                <div class="col-12 col-md-3">
                    <label for="fonte" class="form-label fw-bold">Fonte:</label>
                    <input type="text" name="fonte" id="fonte" placeholder="Ex: Agência Brasil / Redação" class="form-control" required>
                </div>

                <div class="col-12 col-md-2">
                    <label for="categoria" class="form-label fw-bold">Editoria:</label>
                    <select name="categoria" id="categoria" class="form-select" required>
                        {{#each categorias}}
                            <option value="{{_id}}">{{nome}}</option>
                        {{else}}
                            <option value="0">Nenhuma categoria registrada</option>
                        {{/each}}
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label for="carousel" class="form-label fw-bold">Destaque (Carousel):</label>
                    <select name="carousel" id="carousel" class="form-select" required>
                        <option value="true">Sim (Capa)</option>
                        <option value="false">Não</option>
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label for="file" class="form-label fw-bold">Imagem de Capa:</label>
                    <input type="file" id="file" name="file" accept="image/*" class="form-control" required>
                </div>

                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-yellow px-5 py-2">Publicar Matéria</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="/tinymce/tinymce.min.js"></script>
<script>
    tinymce.init({
        selector: 'textarea',
        plugins: 'link image code lists',
        toolbar: 'undo redo | bold italic | bullist numlist | link image | code',
        promotion: false,
        branding: false
    });

    // Gerador automático de Slug ao digitar o título
    const tituloInput = document.getElementById('titulo');
    const slugInput = document.getElementById('slug');
    if (tituloInput && slugInput) {
        tituloInput.addEventListener('input', function () {
            slugInput.value = tituloInput.value
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        });
    }
</script>
