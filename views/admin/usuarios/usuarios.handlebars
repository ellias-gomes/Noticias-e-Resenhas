<div class="container mt-4">
    <h1 class="display-6 fw-bold">Usuários registrados</h1>
    <hr>
    <div class="row">
        <div class="col-12 col-md-3">
            <p class="text-justify">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus ullamcorper fringilla congue. Vestibulum quis orci est. Sed sit amet efficitur erat. Proin eu enim semper, mattis ante ac, vehicula nulla. Donec vel libero ut quam accumsan ornare. Proin lobortis quam nisl, sit amet porttitor mauris posuere in. Sed rutrum aliquam sagittis. Aenean at nisl non ante egestas euismod sit amet eu erat.</p>
        </div>
        <div class="col-12 col-md-9 text-center">
            <div class="row">
                {{#each users}}
                    <div class="container mt-2 col-12 col-lg-6 pb-3 listagem">
                        <h4>{{nome}}</h4>
                        <small>{{email}}</small><br>
                        {{#if Admin}}
                            <small>Administrador</small><br>
                            {{else}}
                                <small>Usuário</small><br>
                        {{/if}}
                        {{#if confirm}}
                            <small>E-mail confirmado</small><br>
                            {{else}}
                                <small>E-mail pendente</small><br>
                        {{/if}}
                        <a href="/users/usuario/{{_id}}"><button class="btn btn-primary mt-2 w-75">Informações do usuário</button></a>
                        <button class="btn btn-success mt-2 w-75"  data-bs-toggle="modal" data-bs-target="#modalAdmin{{_id}}">Definir admin</button></a>
                        <button type="button" class="btn btn-danger mt-2 w-75" data-bs-toggle="modal" data-bs-target="#modalDeletar{{_id}}">Deletar usuário</button>
                    </div>
                    <!-- Modal -->
                    <div class="modal fade" id="modalDeletar{{_id}}" tabindex="-1" aria-labelledby="modalDeletar" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Deletar usuário?</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                Tem certeza que deseja deletar o usuário "{{nome}}"?
                            </div>
                            <div class="modal-footer">
                                <form action="/users/deletar/" method="POST">
                                    <input type="hidden" name="id" value="{{_id}}">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                    <button type="submit" class="btn btn-danger pt-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 448 512"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"/></svg>
                                    </button>
                                </form>
                            </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modalAdmin{{_id}}" tabindex="-1" aria-labelledby="modalAdmin" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Definir admin</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                Tem certeza que deseja definir "{{nome}}" como admin?
                            </div>
                            <div class="modal-footer">
                                <form action="/users/edit" method="POST">
                                    <input type="hidden" name="id" value="{{_id}}">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                    <button type="submit" class="btn btn-success pt-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"/></svg>
                                    </button>
                                </form>
                            </div>
                            </div>
                        </div>
                    </div>
                    {{else}}
                    <div class="container text-center">
                        <h4 class="mt-2">Nenhum usuário registrado!</h4>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>