<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <span class="badge-category mb-1">EDITORIA</span>
            <h1 class="display-6 fw-bold mb-0">{{categoria.nome}}</h1>
        </div>
        <a href="/" class="btn btn-outline-dark btn-sm">← Todas as Notícias</a>
    </div>
    <hr>

    {{#each postagens}}
        <article class="news-card mb-4 position-relative">
            <div class="row g-0">
                <div class="col-md-4 news-card-img-wrap">
                    <img src="{{img}}" onerror="this.onerror=null;this.src='{{imageUrl slug 'post'}}';" alt="{{titulo}}" class="news-card-img">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-4 d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge-category">{{../categoria.nome}}</span>
                                <small class="text-muted">{{readingTime conteudo}}</small>
                            </div>
                            <h3 class="h4 news-card-title mb-2">{{titulo}}</h3>
                            <p class="mb-3 text-muted">{{descricao}}</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                            <span>Por <strong>{{autor}}</strong> • {{formatDate date}}</span>
                            <span class="fw-semibold">👁 {{views}} • <span style="color: #D49600;">★ {{likes}}</span></span>
                        </div>
                        <a href="/post/{{slug}}" class="stretched-link"></a>
                    </div>
                </div>
            </div>
        </article>
    {{else}}
        <div class="card border-0 shadow-sm text-center py-5">
            <h5 class="fw-bold mb-1">Nenhuma postagem nesta categoria ainda!</h5>
            <p class="text-muted small mb-0">Explore outras editorias na barra superior.</p>
        </div>
    {{/each}}
</div>
