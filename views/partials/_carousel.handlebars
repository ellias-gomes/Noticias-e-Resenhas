<div id="carousel" class="carousel slide hero-carousel-wrapper" data-bs-ride="carousel">
    {{#if carouselPosts.length}}
        <div class="carousel-indicators">
            {{#each carouselPosts}}
                <button type="button" data-bs-target="#carousel" data-bs-slide-to="{{@index}}" {{#if @first}}class="active" aria-current="true"{{/if}} aria-label="Slide {{@index}}"></button>
            {{/each}}
        </div>
    {{/if}}
    <div class="carousel-inner">
        {{#each carouselPosts}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <a href="/post/{{slug}}" class="text-decoration-none">
                    <img src="{{img}}" onerror="this.onerror=null;this.src='{{imageUrl slug 'post'}}';" class="d-block carousel" alt="{{titulo}}">
                    <div class="carousel-caption hero-caption-box text-light">
                        <div class="container">
                            {{#if categoria}}
                                <span class="badge-category mb-2">{{categoria.nome}}</span>
                            {{else}}
                                <span class="badge-category mb-2">DESTAQUE</span>
                            {{/if}}
                            <h2 class="fw-bolder text-white mb-2 display-6">{{titulo}}</h2>
                            <p class="mb-2 text-light opacity-75 d-none d-md-block col-lg-8">{{descricao}}</p>
                            <div class="small text-warning fw-semibold">
                                <span>Por {{autor}}</span> • <span>{{formatDate date}}</span> • <span>{{readingTime conteudo}}</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {{else}}
            <div class="carousel-item active">
                <img src="/img/slide.jpg" class="d-block carousel" alt="Notícias">
                <div class="carousel-caption hero-caption-box text-light">
                    <div class="container">
                        <span class="badge-category mb-2">PORTAL DE NOTÍCIAS</span>
                        <h2 class="fw-bolder text-white mb-2">Informação em Tempo Real</h2>
                        <p class="mb-0 text-light opacity-75">Acompanhe, curta, comente e compartilhe as principais matérias do dia.</p>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Próximo</span>
    </button>
</div>
