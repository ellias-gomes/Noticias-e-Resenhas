<div class="container mt-4 mb-3" id="comentarios">
    <div class="section-header">
        <h3 class="fw-bold mb-0">Comentários da Comunidade ({{comentario.length}})</h3>
    </div>

    <!-- ADICIONAR COMENTÁRIO -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            {{#if user}}
                <form action="/posts/{{postagem.slug}}/addcomentario" method="post">
                    <input type="hidden" name="postagem" id="postagem" value="{{postagem._id}}">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="{{imageUrl user._id 'user'}}" onerror="this.onerror=null;this.src='/img/icon.svg';" alt="Avatar" width="32" height="32" class="rounded-circle" style="object-fit: cover; border: 2px solid #FFB800;">
                        <span class="fw-bold small">Comentando como {{user.nome}}</span>
                    </div>
                    <div class="mb-3">
                        <textarea name="comentario" id="comentario" rows="3" placeholder="Participe da discussão! Qual a sua opinião sobre esta notícia?" class="form-control" required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-yellow px-4">
                            Publicar Comentário
                        </button>
                    </div>
                </form>
            {{else}}
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 py-2">
                    <div>
                        <h6 class="fw-bold mb-1">Quer participar da conversa?</h6>
                        <p class="text-muted small mb-0">Entre na sua conta ou cadastre-se gratuitamente para comentar e curtir notícias.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/users/login" class="btn btn-dark btn-sm px-3">Entrar</a>
                        <a href="/users/registro" class="btn btn-yellow btn-sm px-3">Criar Conta</a>
                    </div>
                </div>
            {{/if}}
        </div>
    </div>

    <!-- LISTA DE COMENTÁRIOS -->
    <div class="d-flex flex-column gap-3">
        {{#each comentario}}
            <div class="comment-card">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <img src="{{imageUrl userId 'user'}}" onerror="this.onerror=null;this.src='/img/icon.svg';" alt="Imagem de perfil" class="imgComments">
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h6 class="fw-bold mb-0">{{usuario}}</h6>
                                <small class="text-muted">• {{formatDate date}}</small>
                            </div>
                            <p class="mb-0 mt-2 text-break">{{comentario}}</p>
                        </div>
                    </div>
                    {{#if canDelete}}
                        <form action="/posts/{{../postagem.slug}}/delcomentario/{{_id}}" method="POST" onsubmit="return confirm('Deseja remover este comentário?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Excluir comentário">
                                ✕
                            </button>
                        </form>
                    {{/if}}
                </div>
            </div>
        {{else}}
            <div class="text-center py-4 text-muted bg-white rounded-3 border">
                <p class="mb-0">Seja o primeiro a comentar nesta publicação!</p>
            </div>
        {{/each}}
    </div>
</div>
