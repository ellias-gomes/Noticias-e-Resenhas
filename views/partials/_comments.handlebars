<div class="container mt-2 mb-2">
    <h3 class="mb-3">Comentários</h3>

    <!--COMENTARIOS-->
    <div>
        {{#each comentario}}
            <div class="row mb-3 mt-3 align-items-center">
                <div class="col-3 col-sm-2 col-lg-1">
                    <img src="{{imageUrl userId 'user'}}" onerror="this.onerror=null;this.src='/img/icon.svg';" alt="Imagem de perfil" class="imgComments">
                </div>
                <div class="col-9 col-sm-10 col-lg-11">
                    <div class="row text-break">
                        <h5 class="mb-0">{{usuario}} <small class="text-muted fs-6 fw-normal">• {{formatDate date}}</small></h5>
                    </div>
                    <div class="row text-break"><p class="mb-0 mt-1">{{comentario}}</p></div>
                </div>
            </div>
        {{else}}
            <div class="row mb-3 mt-3">
                <div class="col-12">
                    <p>Nenhum comentário!</p>
                </div>
            </div>
        {{/each}}
    </div>

    <!--ADICIONAR COMENTARIO-->
    <div>
        <form action="/posts/{{postagem.slug}}/addcomentario" method="post">
            <input type="hidden" name="postagem" id="postagem" value="{{postagem._id}}">
            <div class="row d-flex justify-content-left">
                <div class="col-12 mb-2">
                    <textarea name="comentario" id="comentario" rows="3" placeholder="Escreva seu comentário..." class="form-control" required></textarea>
                </div>
            </div>
            <div class="row d-flex text-end">
                <div class="col-12">
                    <input type="submit" value="Enviar" class="btn btn-success col-12 col-md-4 col-lg-2">
                </div>
            </div>
        </form>
    </div>
</div>
