<div class="container mt-4 mb-5">
    <div class="section-header">
        <h3 class="fw-bold mb-0">Continue Lendo</h3>
    </div>
    <div class="row g-4">
        {{#each recomendadas}}
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card news-card h-100">
                    <img src="{{img}}" onerror="this.onerror=null;this.src='{{imageUrl slug 'post'}}';" class="card-img-top" alt="{{titulo}}" style="aspect-ratio: 16/10; object-fit: cover;">
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div>
                            {{#if categoria.nome}}
                                <span class="badge-category mb-2">{{categoria.nome}}</span>
                            {{/if}}
                            <h6 class="news-card-title mb-2">{{titulo}}</h6>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted mt-2 pt-2 border-top">
                            <span>👁 {{views}}</span>
                            <span>★ {{likes}}</span>
                        </div>
                        <a href="/post/{{slug}}" class="stretched-link"></a>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="col-12 text-muted">Nenhuma outra recomendação no momento.</div>
        {{/each}}
    </div>
</div>
