<div class="container mt-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h1 class="display-6 fw-bold mb-0">Últimas Notícias</h1>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            {{#each categorias}}
                <a href="/categoria/{{slug}}" class="btn btn-outline-dark btn-sm">{{nome}}</a>
            {{/each}}
        </div>
    </div>
    <hr>

    {{#each postagens}}
        <div class="card mb-3 text-dark bg-light border-light shadow-sm">
            <div class="row g-0">
                <div class="col-md-4">
                    <img src="{{imageUrl slug 'post'}}" onerror="this.onerror=null;this.src='/img/slide.jpg';" alt="{{titulo}}" class="img-fluid rounded-start w-100" style="aspect-ratio: 2/1; height: 100%; object-fit: cover;">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        {{#if categoria}}
                            <span class="badge bg-secondary mb-2">{{categoria.nome}}</span>
                        {{/if}}
                        <h3 class="card-title">{{titulo}}</h3>
                        <p class="mb-2 card-text">{{descricao}}</p>
                        <small class="text-muted">Data de publicação: {{formatDate date}}</small><br>
                        <a href="/post/{{slug}}" class="btn stretched-link ms-0"></a>
                    </div>
                </div>
            </div>
        </div>
    {{else}}
        <div class="alert alert-secondary text-center py-4">
            <h5 class="mb-1">Nenhuma postagem publicada ainda!</h5>
            <p class="mb-0 text-muted">Acesse o painel de administração para criar categorias e publicar notícias.</p>
        </div>
    {{/each}}
</div>
