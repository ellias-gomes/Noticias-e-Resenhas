# Configurações do Servidor
PORT=8081
NODE_ENV=development
BASE_URL=http://localhost:8081

# Banco de Dados ('auto', 'mongodb', ou 'sqlite')
# 'auto' tenta MongoDB; se não estiver funcionando, ativa o SQLite automaticamente
DB_CLIENT=auto
MONGO_URI=mongodb://127.0.0.1:27017/noticias
SQLITE_PATH=./data/noticias.sqlite

# Segurança de Sessão
SESSION_SECRET=sua_chave_secreta_aqui

# Armazenamento de Imagens ('local' para armazenamento gratuito local ou 's3' para Amazon S3)
STORAGE_TYPE=local

# Configuração AWS S3 (Estrutura secundária - preencha caso mude STORAGE_TYPE para 's3')
AWS_ACCESS_KEY_ID=sua_access_key_id
AWS_SECRET_ACCESS_KEY=sua_secret_access_key
AWS_REGION=sa-east-1
AWS_BUCKET_NAME=seu_bucket_name

# Configuração de E-mail (SendGrid ou SMTP padrão)
SENDGRID_API_KEY=
EMAIL_FROM=seu_email@dominio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
